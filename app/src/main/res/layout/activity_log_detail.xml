<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_premium_gradient">

    <!-- Top Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="戻るボタン"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/icon_tint_color" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ログ詳細"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Detail Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <!-- Event Name -->
        <TextView
            android:id="@+id/detailEventName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="急ブレーキ"
            android:textColor="@color/score_red"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Info Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item: Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="発生日時"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/detailDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YY/MM/DD-hh:mm:ss"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Item: Location Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="発生場所"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/detailLocationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="東京都新宿区西新宿"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Item: Coordinates -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="緯度経度"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/detailCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="35.6895, 139.6917"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Item: G force -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="検出加速度 (X, Z)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/detailGForce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="X: 0.12G, Z: -0.45G"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
